#!/usr/bin/env python3
"""Report English conversation titles to the sidebar; use Nerd Font logos in the top bar.
Persian titles are translated once with a short `claude -p` call (Haiku) and cached in
~/.config/herdr/title-cache.json.
Usage: herdr-tab-titles          (once)
       herdr-tab-titles --watch  (keep them in sync every 5 s)"""
import argparse, json, os, re, sqlite3, subprocess, sys, time
from pathlib import Path
from contextlib import closing

CACHE = Path.home() / ".config/herdr/title-cache.json"
TAB_LABELS = Path.home() / ".config/herdr/saved-tab-labels.json"
BLANK_TAB = "\u2800"  # Legacy blank label and fallback for unknown agents
TAB_ICONS = {"claude": "\uec82", "codex": "\uec81", "opencode": "▣"}  # Nerd Fonts: cod-claude, cod-openai
MANAGED_LABELS = {BLANK_TAB} | {
    "".join(icon for index, icon in enumerate(TAB_ICONS.values()) if mask & (1 << index))
    for mask in range(1, 1 << len(TAB_ICONS))
}
TERMINAL_ICON = "\uf489"  # Nerd Fonts: oct-terminal
OS_ICONS = {"darwin": "\uf179", "ubuntu": "\uf31b", "linux": "\uf17c", "remote": "\uf0ac"}
SHELL_ICONS = {TERMINAL_ICON, *OS_ICONS.values()}
HOST_CACHE = {}
MODEL_FILE_CACHE = {}
NUMBERED_LABEL = re.compile(r"^\d+\.? (.*)$")
NON_LATIN = re.compile(r"[؀-ۿﭐ-﷿ﹰ-﻿]")
GENERIC = {"claude code", "codex", ""}


def load_cache():
    try:
        return json.loads(CACHE.read_text())
    except Exception:
        return {}


def to_english(title, cache):
    if not NON_LATIN.search(title):
        return title
    if title in cache:
        return cache[title]
    env = {k: v for k, v in os.environ.items() if not k.startswith("HERDR_")}  # don't register as a herdr agent
    prompt = ("Translate this coding-session title to a short English title (at most 6 words, Title Case). "
              "Reply with the title only, no quotes.\n\n" + title)
    try:
        out = subprocess.run(["claude", "-p", "--model", "haiku", prompt], capture_output=True, text=True,
                             timeout=60, env=env, cwd=str(Path.home())).stdout.strip().splitlines()
        english = (out[0] if out else "").strip().strip('"\'')
    except Exception:
        english = ""
    if not english or NON_LATIN.search(english):
        return None  # try again next round
    cache[title] = english
    CACHE.write_text(json.dumps(cache, ensure_ascii=False, indent=1))
    return english


MAX_WORDS = 6
LINE = 32  # 36-column sidebar minus padding and the state icon


def shorten(title):
    return " ".join(title.split()[:MAX_WORDS])


def two_lines(title):
    """Word-wrap into at most two lines of LINE characters (the second one cut with … if still too long)."""
    first, rest = "", []
    words = title.split()
    while words and len((first + " " + words[0]).strip()) <= LINE:
        first = (first + " " + words.pop(0)).strip()
    if not first and words:  # one very long word
        first, words = words[0][:LINE], [words[0][LINE:]] + words[1:]
    second = " ".join(words)
    if len(second) > LINE:
        second = second[:LINE - 1] + "…"
    return first, second


LOGOS = {"claude": "▐▛███▜▌", "codex": ">_", "opencode": "█▀▀█"}  # colours: ui.sidebar.agents.rows_by_agent in config.toml
# Claude gets the two-line mascot as $m1/$m2 (U+2800 braille blank pads it so herdr does not trim the indent).
MASCOT = {"claude": ("\u2800▐▛███▜▌", "▝▜█████▛▘"),
          "codex": ("\u2800▗█████▖\u2800", "\u2800█ ▪ ▪ █\u2800"),
          "opencode": ("\u2800\u2800█▀▀█\u2800\u2800\u2800", "\u2800\u2800█▒▒█\u2800\u2800\u2800", "\u2800\u2800█▄▄█\u2800\u2800\u2800")}  # Ghost mascot, same 2 x 9 cells as Claude


def last_prompts():
    """{claude session id: epoch s} and {codex thread name: epoch s} of the last prompt the user sent."""
    claude, codex_by_id, names = {}, {}, {}
    for path, kind in ((Path.home() / ".claude/history.jsonl", "claude"), (Path.home() / ".codex/history.jsonl", "codex"),
                       (Path.home() / ".codex/session_index.jsonl", "index")):
        try:
            lines = path.read_text(errors="ignore").splitlines()[-5000:]
        except OSError:
            continue
        for line in lines:
            try:
                row = json.loads(line)
            except ValueError:
                continue
            if kind == "claude" and row.get("sessionId"):
                claude[row["sessionId"]] = max(claude.get(row["sessionId"], 0), row.get("timestamp", 0) / 1000)
            elif kind == "codex" and row.get("session_id"):
                codex_by_id[row["session_id"]] = max(codex_by_id.get(row["session_id"], 0), row.get("ts", 0))
            elif kind == "index" and row.get("thread_name"):
                names[row["thread_name"]] = row.get("id")
    codex = {name: codex_by_id[i] for name, i in names.items() if i in codex_by_id}
    return claude, codex


def ago(ts):
    if not ts:
        return ""
    s = max(0, int(time.time() - ts))
    if s < 60:
        return "just now"
    for size, unit in ((86400, "d"), (3600, "h"), (60, "m")):
        if s >= size:
            return f"{s // size}{unit} ago"


def report(pane, first, second, agent="", since=""):
    args = ["herdr", "pane", "report-metadata", pane, "--source", "herdr-tab-titles", "--token", f"t1={first}"]
    args += ["--token", f"ago={since}"] if since else ["--clear-token", "ago"]
    if agent in LOGOS:
        args += ["--display-agent", LOGOS[agent]]
    if agent in MASCOT:
        for i, line in enumerate(MASCOT[agent], 1):
            args += ["--token", f"m{i}={line}"]
    args += ["--token", f"t2={second}"] if second else ["--clear-token", "t2"]
    r = subprocess.run(args, capture_output=True, text=True)
    if r.returncode:
        print("report failed:", pane, (r.stdout + r.stderr).strip()[:200], flush=True)


def herdr(*args):
    return json.loads(subprocess.run(["herdr", *args], capture_output=True, text=True, check=True).stdout)["result"]


def compact_model_name(model):
    """Keep the model identity while removing provider prefixes and dated suffixes."""
    model = model.rsplit("/", 1)[-1]
    model = re.sub(r"-\d{8}$", "", model)
    match = re.fullmatch(r"claude-(opus|sonnet|haiku)-(\d+)(?:[.-](\d+))?", model)
    if match:
        return match[1].title() + " " + match[2] + ("." + match[3] if match[3] else "")
    if model.startswith("gpt-"):
        version, *suffix = model[4:].split("-")
        return "GPT-" + version + (" " + " ".join(word.title() for word in suffix) if suffix else "")
    if model.startswith("nemotron-"):
        return "Nemotron " + model[len("nemotron-"):].replace("super-vl", "SVL").replace("-free", " Free")
    return model


def claude_session_model(agent, home):
    session = (agent.get("agent_session") or {}).get("value")
    if not session or "/" in session:
        return ""
    projects = home / ".claude/projects"
    path = projects / agent.get("cwd", "").replace("/", "-") / (session + ".jsonl")
    if not path.exists():
        matches = list(projects.glob("*/" + session + ".jsonl"))
        if len(matches) != 1:
            return ""
        path = matches[0]
    stat = path.stat()
    stamp = (stat.st_mtime_ns, stat.st_size)
    cached = MODEL_FILE_CACHE.get(str(path))
    if cached and cached[0] == stamp:
        return cached[1]
    with path.open("rb") as stream:
        offset = max(0, stat.st_size - 2 * 1024 * 1024)
        stream.seek(offset)
        lines = stream.read().splitlines()
    if offset:
        lines = lines[1:]  # The first record can be partial.
    model = ""
    for line in reversed(lines):
        try:
            row = json.loads(line)
        except (ValueError, UnicodeDecodeError):
            continue
        candidate = (row.get("message") or {}).get("model")
        if row.get("type") == "assistant" and candidate and candidate != "<synthetic>":
            model = candidate
            break
    MODEL_FILE_CACHE[str(path)] = (stamp, model)
    return model


def session_model(agent, home=None):
    """Read model identity only from an unambiguously matched local session."""
    home = home or Path.home()
    kind = agent["agent"]
    try:
        if kind == "claude":
            return claude_session_model(agent, home)
        if kind == "codex":
            path = home / ".codex/state_5.sqlite"
            if not path.exists():
                return ""
            with closing(sqlite3.connect(path.as_uri() + "?mode=ro", uri=True, timeout=0.2)) as db:
                columns = {row[1] for row in db.execute("pragma table_info(threads)")}
                if "model" not in columns:
                    return ""
                session = (agent.get("agent_session") or {}).get("value")
                if session:
                    rows = db.execute("select model from threads where id = ?", (session,)).fetchall()
                else:
                    title = agent.get("terminal_title_stripped", "").split(" | ")[0].strip()
                    title = re.sub(r"^[\u2800-\u28ff]\s*", "", title)
                    if not title:
                        return ""
                    fields = [field for field in ("name", "title") if field in columns]
                    condition = " or ".join(field + " = ?" for field in fields)
                    if not condition:
                        return ""
                    rows = db.execute("select model from threads where archived = 0 and cwd = ? and (" + condition + ")",
                                      (agent.get("cwd", ""), *([title] * len(fields)))).fetchall()
                return rows[0][0] or "" if len(rows) == 1 else ""
        if kind == "opencode":
            path = home / ".local/share/opencode/opencode.db"
            if not path.exists():
                return ""
            with closing(sqlite3.connect(path.as_uri() + "?mode=ro", uri=True, timeout=0.2)) as db:
                columns = {row[1] for row in db.execute("pragma table_info(session_v2)")}
                if "model" not in columns:
                    return ""
                session = (agent.get("agent_session") or {}).get("value")
                if session:
                    rows = db.execute("select model from session_v2 where id = ?", (session,)).fetchall()
                else:
                    rows = db.execute("select model from session_v2 where directory = ? and parent_id is null and time_archived is null",
                                      (agent.get("cwd", ""),)).fetchall()
                if len(rows) != 1 or not rows[0][0]:
                    return ""
                model = json.loads(rows[0][0])
                return model.get("id") or model.get("modelID") or ""
    except (OSError, sqlite3.Error, ValueError, TypeError, AttributeError):
        return ""
    return ""


def refresh_sidebar_mascots(tabs, agents):
    """Initialize new agents' sidebar art without changing existing conversation titles."""
    positions, seen = {}, {}
    for tab in tabs:
        workspace = tab["workspace_id"]
        seen[workspace] = seen.get(workspace, 0) + 1
        positions[tab["tab_id"]] = seen[workspace]
    for agent in agents:
        kind = agent["agent"]
        if kind not in MASCOT:
            continue
        tokens = agent.get("tokens", {})
        model = compact_model_name(session_model(agent))
        args = ["pane", "report-metadata", agent["pane_id"], "--source", "herdr-tab-titles"]
        if kind in ("claude", "codex") and tokens.get("logo_gap") != "\u2800":
            args.extend(["--token", "logo_gap=\u2800"])
        if model != tokens.get("model", ""):
            args.extend(["--token", f"model={model}"] if model else ["--clear-token", "model"])
        if agent.get("display_agent") != LOGOS[kind]:
            args.extend(["--display-agent", LOGOS[kind]])
        for index, line in enumerate(MASCOT[kind], 1):
            if tokens.get(f"m{index}") != line:
                args.extend(["--token", f"m{index}={line}"])
        if not tokens.get("t1"):
            title = agent.get("terminal_title_stripped") or kind.title()
            first, second = two_lines(f"{positions.get(agent['tab_id'], '?')} {title}")
            args.extend(["--token", f"t1={first}"])
            if second:
                args.extend(["--token", f"t2={second}"])
        if len(args) > 5:
            subprocess.run(["herdr", *args], capture_output=True, text=True, check=True)


def saved_labels():
    try:
        return json.loads(TAB_LABELS.read_text())
    except FileNotFoundError:
        return {}


def save_labels(labels):
    TAB_LABELS.parent.mkdir(parents=True, exist_ok=True)
    temporary = TAB_LABELS.with_suffix(".tmp")
    temporary.write_text(json.dumps(labels, ensure_ascii=False, indent=2) + "\n")
    temporary.replace(TAB_LABELS)


def local_os_icon():
    if sys.platform == "darwin":
        return OS_ICONS["darwin"]
    if sys.platform.startswith("linux"):
        try:
            release = __import__("platform").freedesktop_os_release()
        except OSError:
            release = {}
        return OS_ICONS.get(release.get("ID"), OS_ICONS["linux"])
    return TERMINAL_ICON


def ssh_connection_args(argv):
    """Keep connection options, excluding forwarding, commands, and control operations."""
    if not argv or Path(argv[0]).name != "ssh":
        return None
    takes_value = set("BbcDEeFIiJLlmOopQPRSWw")
    keep_value = set("BbcFIiJlmopPS")
    keep_flag = set("46C")
    known_flag = set("46AaCfGgKkMNnqsTtVvXxYyZ")
    result = []
    index = 1
    while index < len(argv):
        arg = argv[index]
        index += 1
        if arg == "--":
            if index < len(argv):
                return result + [argv[index]]
            return None
        if not arg.startswith("-") or arg == "-":
            return result + [arg]
        flags = arg[1:]
        while flags:
            flag, flags = flags[0], flags[1:]
            if flag in takes_value:
                if flags:
                    value, flags = flags, ""
                elif index < len(argv):
                    value = argv[index]
                    index += 1
                else:
                    return None
                if flag in "OQW":
                    return None  # Control/query/stdio transports aren't remote shells.
                if flag in keep_value:
                    result.extend(["-" + flag, value])
                break
            if flag not in known_flag or flag in "GV":
                return None
            if flag in keep_flag:
                result.append("-" + flag)
    return None


def remote_os_icon(connection):
    key = tuple(connection)
    now = time.monotonic()
    cached = HOST_CACHE.get(key)
    if cached and cached[0] > now:
        return cached[1]
    options = ["BatchMode=yes", "ConnectTimeout=3", "ConnectionAttempts=1",
               "StrictHostKeyChecking=yes", "RequestTTY=no", "RemoteCommand=none",
               "SessionType=default", "ForkAfterAuthentication=no", "StdinNull=yes",
               "ClearAllForwardings=yes", "ForwardAgent=no", "ForwardX11=no",
               "PermitLocalCommand=no", "ControlMaster=no"]
    args = ["ssh"]
    for option in options:
        args.extend(["-o", option])
    probe = "printf '__HERDR_OS__\\n'; uname -s; if test -r /etc/os-release; then sed -n 's/^ID=//p' /etc/os-release; fi"
    args.extend(connection)
    args.append(probe)
    icon, ttl = OS_ICONS["remote"], 60
    try:
        response = subprocess.run(args, stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=5)
        lines = response.stdout.splitlines()
        if response.returncode == 0 and "__HERDR_OS__" in lines:
            data = lines[lines.index("__HERDR_OS__") + 1:]
            kernel = data[0].strip().lower() if data else ""
            distro = data[1].strip().strip("\"'").lower() if len(data) > 1 else ""
            icon = OS_ICONS.get(distro, OS_ICONS.get(kernel, OS_ICONS["remote"]))
            ttl = 600
    except (OSError, subprocess.TimeoutExpired):
        pass
    HOST_CACHE[key] = (time.monotonic() + ttl, icon)
    return icon


def terminal_icons(tabs, agents):
    counts = {}
    for agent in agents:
        counts[agent["tab_id"]] = counts.get(agent["tab_id"], 0) + 1
    shell_tabs = {tab["tab_id"] for tab in tabs if counts.get(tab["tab_id"], 0) != tab.get("pane_count", 1)}
    if not shell_tabs:
        return {}
    by_tab = {}
    for pane in herdr("pane", "list")["panes"]:
        if pane["tab_id"] in shell_tabs:
            by_tab.setdefault(pane["tab_id"], []).append(pane)
    icons = {}
    for tab, panes in by_tab.items():
        pane = next((pane for pane in panes if pane.get("focused")), panes[0])
        icon = local_os_icon()
        try:
            info = herdr("pane", "process-info", "--pane", pane["pane_id"])["process_info"]
            for process in info.get("foreground_processes", []):
                argv = process.get("argv", [])
                if argv and Path(argv[0]).name == "ssh":
                    connection = ssh_connection_args(argv)
                    icon = remote_os_icon(connection) if connection else OS_ICONS["remote"]
                    break
        except (KeyError, OSError, subprocess.SubprocessError):
            continue
        icons[tab] = icon
    return icons


def undecorated_label(label):
    """Remove only decorations generated by this script, preserving user names."""
    match = NUMBERED_LABEL.fullmatch(label)
    if match:
        tail = match.group(1)
        if tail in MANAGED_LABELS or any(tail.startswith(icon + " ") for icon in SHELL_ICONS):
            label = tail
    for icon in SHELL_ICONS:
        if label.startswith(icon + " "):
            return label[len(icon) + 1:]
    return label


def update_tab_labels(tabs, agents, restore=False, host_icons=None):
    """Number every tab; use logos for agents and a terminal icon for shells."""
    saved = saved_labels()
    groups = {}
    for agent in agents:
        groups.setdefault(agent["tab_id"], []).append(agent)
    live = {tab["tab_id"] for tab in tabs}
    saved = {key: value for key, value in saved.items() if key in live}
    positions = {}
    for tab in tabs:
        key, label = tab["tab_id"], tab.get("label", "")
        workspace = tab.get("workspace_id", "")
        positions[workspace] = positions.get(workspace, 0) + 1
        number = positions[workspace]
        base = undecorated_label(label)
        group = groups.get(key, [])
        all_agents = bool(group) and len(group) == tab.get("pane_count", 1)
        if base in MANAGED_LABELS:
            base = saved.get(key, "Terminal")
        if restore:
            desired = base
            saved.pop(key, None)
        else:
            saved[key] = base
            if all_agents:
                kinds = {agent.get("agent") for agent in group}
                icon = "".join(glyph for kind, glyph in TAB_ICONS.items() if kind in kinds) or BLANK_TAB
                desired = f"{number}. {icon}"
            else:
                desired = f"{number}. {(host_icons or {}).get(key, TERMINAL_ICON)} {base}"
        if label != desired:
            save_labels(saved)  # Persist recovery names before renaming.
            herdr("tab", "rename", key, desired)
    save_labels(saved)


def sync():

    cache = load_cache()
    claude_last, codex_last = last_prompts()
    agents = herdr("agent", "list")["agents"]
    tabs = herdr("tab", "list")["tabs"]
    saved = saved_labels()
    labels = {t["tab_id"]: saved.get(t["tab_id"], t.get("label", "")) for t in tabs}
    position, seen = {}, {}
    for t in tabs:  # herdr lists tabs in their order; prefix+N switches to the Nth tab of the workspace
        seen[t["workspace_id"]] = seen.get(t["workspace_id"], 0) + 1
        position[t["tab_id"]] = seen[t["workspace_id"]]
    by_tab = {}
    for a in agents:
        by_tab.setdefault(a["tab_id"], []).append(a)
    for tab, group in by_tab.items():
        title = (group[0].get("terminal_title_stripped") or "").removesuffix(" | hrt").strip()
        if len(group) != 1:
            continue
        a = group[0]
        session = (a.get("agent_session") or {}).get("value")
        since = ago(claude_last.get(session) if a["agent"] == "claude" else codex_last.get(title))
        english = None if title.lower() in GENERIC else to_english(title, cache)
        if not english:  # no real title yet: show the tab's own name
            report(a["pane_id"], *two_lines(f"{position.get(tab, '?')} " + (labels.get(tab) or a["agent"])), agent=a["agent"], since=since)
            continue
        english = shorten(english)
        report(a["pane_id"], *two_lines(f"{position.get(tab, '?')} {english}"), agent=a["agent"], since=since)
    refresh_sidebar_mascots(tabs, agents)
    update_tab_labels(tabs, agents, host_icons=terminal_icons(tabs, agents))


def main():
    parser = argparse.ArgumentParser(description="Full sidebar titles and numbered Nerd Font tab labels.")
    parser.add_argument("--watch", action="store_true", help="Refresh every 5 seconds")
    parser.add_argument("--restore-tabs", action="store_true", help="Restore saved tab labels and exit")
    parser.add_argument("--labels-only", action="store_true", help="Number and icon-label tabs without changing sidebar titles")
    args = parser.parse_args()
    if os.environ.get("HERDR_ENV") != "1":
        parser.error("Run inside a Herdr-managed pane (HERDR_ENV=1).")
    if args.restore_tabs:
        update_tab_labels(herdr("tab", "list")["tabs"], [], restore=True)
        return
    while True:
        try:
            if args.labels_only:
                tabs = herdr("tab", "list")["tabs"]
                agents = herdr("agent", "list")["agents"]
                refresh_sidebar_mascots(tabs, agents)
                update_tab_labels(tabs, agents, host_icons=terminal_icons(tabs, agents))
            else:
                sync()
        except Exception as error:
            if not args.watch:
                raise
            print("skip:", error, flush=True)
        if not args.watch:
            return
        time.sleep(5)


if __name__ == "__main__":
    main()
